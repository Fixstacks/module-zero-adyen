{
    "name": "zerofront/module-zero-adyen",
    "description": "Zero for Magento Open Source: payment on Adyen's hosted page for Zero Checkout: cards, wallets and every local method switched on in the Adyen account; HMAC-signed webhooks.",
    "type": "magento2-module",
    "version": "1.3.3",
    "license": [
        "OSL-3.0",
        "AFL-3.0"
    ],
    "authors": [
        {
            "name": "Roman Pasichnyk"
        }
    ],
    "homepage": "https://zerofront.dev",
    "keywords": [
        "magento",
        "magento2",
        "magento-open-source",
        "zero",
        "adyen",
        "payment"
    ],
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0",
        "magento/framework": "103.0.*",
        "magento/module-config": "*",
        "magento/module-directory": "*",
        "magento/module-payment": "*",
        "magento/module-quote": "*",
        "magento/module-sales": "*",
        "magento/module-store": "*",
        "zerofront/module-zero-checkout": "^1.3"
    },
    "replace": {
        "fixstacks/module-zero-adyen": "self.version"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Zero\\Adyen\\": ""
        }
    }
}
